{
  "name": "task2-payment-registry",
  "private": true,
  "version": "1.0.0",
  "description": "PR3 Variant 1 (Banking & FinTech): interbank payment order status registry - Hardhat 3",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:unit": "hardhat test solidity test/solidity/PaymentOrderRegistry.unit.t.sol",
    "test:fuzz": "hardhat test solidity test/solidity/PaymentOrderRegistry.fuzz.t.sol",
    "test:invariant": "hardhat test solidity test/solidity/invariant/PaymentOrderRegistry.invariant.t.sol test/solidity/invariant/PaymentOrderHandler.sol",
    "test:integration": "hardhat test nodejs",
    "test:report": "node scripts/run-and-log.mjs",
    "coverage": "hardhat test --coverage",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "interact:local": "hardhat run scripts/interact.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "interact:sepolia": "hardhat run scripts/interact.ts --network sepolia",
    "wallet:new": "hardhat run scripts/new-wallet.ts",
    "accounts:sepolia": "hardhat run scripts/accounts.ts --network sepolia",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "3.1.8",
    "@nomicfoundation/hardhat-ignition-viem": "3.1.6",
    "@nomicfoundation/hardhat-keystore": "3.1.1",
    "@nomicfoundation/hardhat-network-helpers": "3.0.11",
    "@nomicfoundation/hardhat-node-test-runner": "3.1.0",
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@nomicfoundation/hardhat-verify": "3.1.2",
    "@nomicfoundation/hardhat-viem": "3.0.9",
    "@nomicfoundation/hardhat-viem-assertions": "3.1.3",
    "@nomicfoundation/ignition-core": "3.1.10",
    "@openzeppelin/contracts": "5.6.1",
    "@types/node": "22.20.5",
    "forge-std": "https://github.com/foundry-rs/forge-std/archive/refs/tags/v1.16.2.tar.gz",
    "hardhat": "3.18.1",
    "typescript": "6.0.3",
    "viem": "2.57.3"
  },
  "engines": {
    "node": ">=22.10.0"
  }
}
